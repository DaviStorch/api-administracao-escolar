@model Frontend.Models.Professor

@{
    ViewData["Title"] = "Excluir Professor";
}
 
<div class="page-header" style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="mb-1"><i class="bi bi-trash-fill me-2"></i>Excluir Professor</h1>
                <p class="mb-0 opacity-75">Confirme a exclusão de <strong>@Model.Nome</strong></p>
            </div>
            <a asp-action="Index" class="btn btn-light">
                <i class="bi bi-arrow-left me-2"></i>Cancelar
            </a>
        </div>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card fade-in border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmação de Exclusão</h5>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="bi bi-trash text-danger" style="font-size: 2rem;"></i>
                        </div>
                        <h4 class="mb-2">Tem certeza?</h4>
                        <p class="text-muted mb-0">Esta ação não pode ser desfeita. O aluno será removido permanentemente.</p>
                    </div>
                    
                    <dl class="row mb-4">
                        <dt class="col-sm-3 text-muted">Nome</dt>
                        <dd class="col-sm-9 fw-medium">@Model.Nome</dd>

                        <dt class="col-sm-3 text-muted">E-mail</dt>
                        <dd class="col-sm-9">@Model.Email</dd>

                        <dt class="col-sm-3 text-muted">Matrícula</dt>
                        <dd class="col-sm-9">
                            <code class="bg-light px-2 py-1 rounded">@Model.Materia</code>
                        </dd>
                    </dl>
                    
                    <div class="alert alert-warning d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-4"></i>
                        <div>
                            <strong>Atenção:</strong> O aluno será removido permanentemente do banco de dados.
                        </div>
                    </div>
                    <!-- 1. O method deve ser "post" -->
                    <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
                        <input type="hidden" asp-for="Id" />
                        @Html.AntiForgeryToken()
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-x-lg me-2"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="bi bi-trash me-2"></i>Sim, Excluir Permanentemente
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>