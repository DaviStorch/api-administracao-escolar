@model Frontend.Models.Professor

@{
    ViewData["Title"] = "Detalhes do Professor";
}
 
<div class="header-professores">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="mb-1"><i class="bi bi-person-circle me-2"></i>Detalhes do Professor</h1>
                <p class="mb-0 opacity-75">Visualizando informações completas de <strong>@Model.Nome</strong></p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="bi bi-pencil me-2"></i>Editar
                </a>
                <a asp-action="Index" class="btn btn-light">
                    <i class="bi bi-arrow-left me-2"></i>Voltar
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card fade-in">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Informações do Professor</h5>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-muted">ID</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-secondary fs-6 px-3 py-2">@Model.Id</span>
                        </dd>

                        <dt class="col-sm-3 text-muted">Nome Completo</dt>
                        <dd class="col-sm-9 fw-medium fs-5">@Model.Nome</dd>

                        <dt class="col-sm-3 text-muted">E-mail</dt>
                        <dd class="col-sm-9">
                            <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                        </dd>

                        <dt class="col-sm-3 text-muted">Matrícula</dt>
                        <dd class="col-sm-9">
                            <code class="bg-light px-3 py-2 rounded fw-monospace fs-6">@Model.Materia</code>
                        </dd>
                        <dt class="col-sm-3 text-muted">Ativo</dt>
                        <dd class="col-sm-9">
                            <code class="bg-light px-3 py-2 rounded fw-monospace fs-6">@Model.Ativo</code>
                        </dd>
                </div>
                <div class="card-footer bg-white border-top">
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-pencil me-2"></i>Editar
                        </a>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-2"></i>Voltar à Lista
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>